<?xml version="1.0" encoding="utf-8"?>
<resources>
    <string name="app_name">MatChat</string>

    <!-- S2 Welcome. -->
    <string name="welcome_purpose">Private group messaging for your phone.</string>
    <!-- S2: opens S4, signing in with a setup code (QR code or link). -->
    <string name="welcome_qr">Sign in with setup code</string>
    <string name="welcome_password">Sign in with password</string>
    <string name="welcome_help">Help</string>

    <!-- S3 Sign in. -->
    <string name="signin_title">Sign in</string>
    <string name="signin_homeserver_label">Home server</string>
    <string name="signin_username">Username</string>
    <string name="signin_password">Password</string>
    <string name="signin_submit">Sign in</string>
    <!-- Focusable toggle under the password field; label reflects the next action. -->
    <string name="signin_show_password">Show password</string>
    <string name="signin_hide_password">Hide password</string>
    <!-- Errors: what happened, then what to do (UX-SPEC §4). -->
    <string name="signin_error_credentials">That username or password did not work.</string>
    <string name="signin_error_network">No network. Check signal and try again.</string>
    <!-- The phone refused MatChat its own storage (a leftover data folder from
         an earlier install); the fix is on the phone, not the network or password. -->
    <string name="signin_error_storage">MatChat can\'t save on this phone. Open Settings › Apps › MatChat › Storage and clear it, or uninstall and reinstall MatChat, then try again.</string>
    <!-- %1$s is the underlying failure message (bad server, certificate, etc.). -->
    <string name="signin_error_generic">Could not sign in: %1$s</string>

    <!-- Sign in > Options (LEFT softkey) menu. -->
    <string name="signin_opt_update">Software update</string>
    <string name="signin_opt_help">Help</string>
    <!-- Sign in: a row at the end of the form that opens the Options menu. It
         exists because the phone's T9 keyboard takes the softkeys while a text
         box is focused, so Options can't be opened with a softkey from there. -->
    <string name="signin_more_options">More options…</string>

    <!-- S27 "Hide the running notification?" — shown once after sign-in
         (docs/adr/0008). "Background helper" is MatChat's accessibility service;
         keep the name identical to the Settings > Advanced row. -->
    <string name="background_helper_title">Background helper</string>
    <string name="background_helper_body">MatChat can stay connected without the \"MatChat is running\" notification. Turn on MatChat in Accessibility settings.</string>
    <!-- The one focusable row; opens the phone's Accessibility settings. -->
    <string name="background_helper_open">Open Accessibility settings</string>
    <!-- Status line under the row. -->
    <string name="background_helper_status_on">On. No notification needed.</string>
    <string name="background_helper_status_needs_battery">On, but Run in background is not allowed. The notification stays.</string>
    <string name="background_helper_status_off">Off. MatChat shows a notification.</string>
    <!-- S30 "Save contacts to this phone?" (UX-SPEC §S30), shown once after
         sign-in. "Contacts app" is the phone's own address book. -->
    <string name="contacts_prompt_title">Phone contacts</string>
    <string name="contacts_prompt_body">MatChat saves the people you chat with. It can also save them in this phone\'s Contacts app, with their Matrix address. You can change this later in Settings.</string>
    <string name="contacts_prompt_save">Save to phone contacts</string>
    <!-- Shown after the user refuses the contacts permission. -->
    <string name="contacts_prompt_refused">Contacts stay in MatChat only</string>
    <!-- Setup codes (UX-SPEC S3/S4/S32): a QR code or link made on a computer
         holding the sign-in details and/or recovery key, so nothing long is
         typed on the keypad. -->
    <string name="setup_scan">Scan setup code</string>
    <string name="setup_paste">Paste setup link</string>
    <string name="setup_code_title">Sign in with setup code</string>
    <string name="setup_code_question">Do you have a QR setup code ready?</string>
    <string name="setup_code_scan">Scan QR setup code</string>
    <string name="setup_code_help">No, help me set it up</string>
    <string name="setup_not_a_setup_code">That isn\'t a MatChat setup code.</string>
    <string name="setup_too_new">That code was made for a newer MatChat. Update MatChat first.</string>
    <string name="setup_nothing_to_paste">There\'s nothing to paste. Copy the setup link first.</string>
    <!-- S32 "Setup code found". -->
    <string name="setup_found_title">Setup code found</string>
    <!-- %1$s server, %2$s username, %3$s password state, %4$s recovery-key state. -->
    <string name="setup_found_details">Server: %1$s\nUsername: %2$s\nPassword: %3$s\nRecovery key: %4$s</string>
    <!-- The password is never shown, only that the code has one. -->
    <string name="setup_found_hidden">••••••</string>
    <string name="setup_found_included">included</string>
    <string name="setup_found_not_included">not included</string>
    <!-- %1$s the code's server, %2$s the one the organization requires. -->
    <string name="setup_found_blocked_server">This code is for %1$s. Your organization only allows %2$s.</string>
    <string name="setup_found_incomplete">This code doesn\'t have everything needed to sign in.</string>
    <string name="setup_found_fill">Use these and type the rest</string>
    <string name="setup_found_cancel">Cancel</string>
    <!-- Under the sign-in form while a scanned recovery key waits for sign-in. -->
    <string name="setup_recovery_pending">The recovery key from the setup code will be used after you sign in.</string>
    <string name="setup_recovery_failed">Signed in, but that recovery key didn\'t work. Enter it again.</string>
</resources>
