<?xml version="1.0" encoding="utf-8"?>
<!-- A two-line Room Info row (field / info / member). Focusable: CENTER acts. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/focus_selector"
    android:focusable="true"
    android:focusableInTouchMode="false"
    android:minHeight="@dimen/row_min_height_compact"
    android:paddingStart="@dimen/content_pad"
    android:paddingEnd="@dimen/content_pad"
    android:paddingTop="4dp"
    android:paddingBottom="4dp">

    <TextView
        android:id="@+id/roominfo_primary"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:duplicateParentState="true"
        android:textSize="@dimen/text_body"
        android:textColor="?attr/colorTextOnFocus" />

    <TextView
        android:id="@+id/roominfo_secondary"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:duplicateParentState="true"
        android:textSize="@dimen/text_meta"
        android:textColor="?attr/colorTextMetaOnFocus" />
</LinearLayout>
