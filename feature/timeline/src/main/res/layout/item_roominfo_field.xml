<?xml version="1.0" encoding="utf-8"?>
<!-- A two-line Room Info row (field / info / member). Focusable: CENTER acts.
     roominfo_avatar (Avatars round) is gone by default — RoomInfoAdapter
     shows and binds it only for a Member row. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:background="@drawable/focus_selector"
    android:focusable="true"
    android:focusableInTouchMode="false"
    android:minHeight="@dimen/row_min_height_compact"
    android:paddingStart="@dimen/content_pad"
    android:paddingEnd="@dimen/content_pad"
    android:paddingTop="4dp"
    android:paddingBottom="4dp">

    <ImageView
        android:id="@+id/roominfo_avatar"
        android:layout_width="@dimen/avatar_size_sender"
        android:layout_height="@dimen/avatar_size_sender"
        android:layout_marginEnd="8dp"
        android:src="@drawable/avatar_placeholder"
        android:contentDescription="@null"
        android:visibility="gone" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical"
        android:duplicateParentState="true">

        <TextView
            android:id="@+id/roominfo_primary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:duplicateParentState="true"
            android:textSize="@dimen/text_body"
            android:textColor="?attr/colorTextOnFocus" />

        <TextView
            android:id="@+id/roominfo_secondary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:duplicateParentState="true"
            android:textSize="@dimen/text_meta"
            android:textColor="?attr/colorTextMetaOnFocus" />
    </LinearLayout>
</LinearLayout>
