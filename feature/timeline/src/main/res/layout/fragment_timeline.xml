<?xml version="1.0" encoding="utf-8"?>
<!-- S9 Timeline content band: pinned-messages band (Pinned messages
     quick-access round), unencrypted warning (G4), message list, and the
     bottom compose strip (the last focus stop). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <!-- Pinned-messages band: same shape as the room list's invite_band —
         first focus stop, CENTER/click opens Pinned messages. Reaching it
         by walking UP through the whole message history is impractical, so
         it's paired with a D-pad RIGHT shortcut (TimelineFragment
         .onDirectionalKey) as the primary fast path; the band itself stays
         as the discoverable, always-visible affordance. -->
    <TextView
        android:id="@+id/pinned_band"
        style="@style/Widget.MatChat.Row"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="?attr/rowMinHeightCompact"
        android:textSize="?attr/textSizeLabel"
        android:textColor="?attr/colorTextOnFocus"
        android:visibility="gone"
        tools:text="📌 3 pinned messages ›"
        tools:visibility="visible" />

    <TextView
        android:id="@+id/unencrypted_band"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="14dp"
        android:gravity="center_vertical"
        android:paddingStart="@dimen/content_pad"
        android:paddingEnd="@dimen/content_pad"
        android:background="?attr/colorWarning"
        android:textColor="?attr/colorTextOnInverse"
        android:textSize="?attr/textSizeMeta"
        android:text="@string/timeline_unencrypted"
        android:visibility="gone" />

    <TextView
        android:id="@+id/empty_view"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center"
        android:padding="@dimen/content_pad"
        android:textSize="?attr/textSizeBody"
        android:textColor="?attr/colorTextSecondary"
        android:text="@string/timeline_empty"
        android:visibility="gone" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/timeline_list"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:descendantFocusability="afterDescendants"
        android:focusable="false" />

    <!-- Typing indicator (S9): "Alice is typing…". Hidden when nobody is typing. -->
    <TextView
        android:id="@+id/typing_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="14dp"
        android:gravity="center_vertical"
        android:paddingStart="@dimen/content_pad"
        android:paddingEnd="@dimen/content_pad"
        android:textSize="?attr/textSizeMeta"
        android:textColor="?attr/colorTextSecondary"
        android:textStyle="italic"
        android:visibility="gone" />

    <EditText
        android:id="@+id/compose_input"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="18dp"
        android:maxLines="5"
        android:background="@drawable/focus_selector"
        android:focusable="true"
        android:focusableInTouchMode="true"
        android:inputType="textShortMessage|textMultiLine|textCapSentences|textAutoCorrect"
        android:imeOptions="actionSend"
        android:importantForAutofill="no"
        android:textSize="?attr/textSizeBody"
        android:textColor="?attr/colorTextPrimary"
        android:hint="@string/timeline_compose_hint" />

    <!-- Voice recording bar (S9). Shown only while recording; CENTER sends, Back
         cancels. Replaces the compose strip visually during a take. -->
    <TextView
        android:id="@+id/recording_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="18dp"
        android:gravity="center_vertical"
        android:paddingStart="@dimen/content_pad"
        android:paddingEnd="@dimen/content_pad"
        android:background="?attr/colorWarning"
        android:textColor="?attr/colorTextOnInverse"
        android:textSize="?attr/textSizeBody"
        android:visibility="gone" />
</LinearLayout>
