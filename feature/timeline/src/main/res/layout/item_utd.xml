<?xml version="1.0" encoding="utf-8"?>
<!-- Unable-to-decrypt row (S9): plain-language, focusable, CENTER routes to
     verification (S6) — never a scary grey blob. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/focus_selector"
    android:focusable="true"
    android:focusableInTouchMode="false"
    android:minHeight="?attr/rowMinHeightCompact"
    android:paddingStart="@dimen/content_pad"
    android:paddingEnd="@dimen/content_pad"
    android:paddingTop="3dp"
    android:paddingBottom="3dp">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:duplicateParentState="true"
        android:textStyle="italic"
        android:textSize="?attr/textSizeBody"
        android:textColor="?attr/colorTextOnFocus"
        android:text="@string/timeline_utd" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:duplicateParentState="true"
        android:textSize="?attr/textSizeLabel"
        android:textColor="?attr/colorTextLink"
        android:text="@string/timeline_fix_encryption" />
</LinearLayout>
