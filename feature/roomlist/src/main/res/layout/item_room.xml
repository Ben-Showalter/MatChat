<?xml version="1.0" encoding="utf-8"?>
<!-- One room row (S8). Focus lives on the row; the row is the click target
     (AGENTS.md §4). minHeight, never a fixed height, so it grows in large-text
     mode (UX-SPEC S16). room_avatar (Avatars round) sits at the start; name/
     preview shift to sit beside it rather than spanning the full row. -->
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    style="@style/Widget.MatChat.Row"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingTop="6dp"
    android:paddingBottom="6dp">

    <ImageView
        android:id="@+id/room_avatar"
        android:layout_width="?attr/avatarSizeList"
        android:layout_height="?attr/avatarSizeList"
        android:layout_alignParentStart="true"
        android:layout_centerVertical="true"
        android:layout_marginEnd="8dp"
        android:src="@drawable/avatar_placeholder"
        android:contentDescription="@null" />

    <TextView
        android:id="@+id/room_time"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentTop="true"
        android:layout_alignParentEnd="true"
        android:duplicateParentState="true"
        android:textSize="?attr/textSizeMeta"
        android:textColor="?attr/colorTextMetaOnFocus"
        tools:text="3:42 PM" />

    <TextView
        android:id="@+id/room_unread"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_below="@id/room_time"
        android:layout_alignParentEnd="true"
        android:layout_marginTop="2dp"
        android:minWidth="18dp"
        android:gravity="center"
        android:paddingStart="5dp"
        android:paddingEnd="5dp"
        android:background="?attr/colorFocusAccent"
        android:textColor="?attr/colorTextOnInverse"
        android:textSize="?attr/textSizeMeta"
        android:visibility="gone"
        tools:text="3"
        tools:visibility="visible" />

    <TextView
        android:id="@+id/room_name"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentTop="true"
        android:layout_toStartOf="@id/room_time"
        android:layout_toEndOf="@id/room_avatar"
        android:duplicateParentState="true"
        android:maxLines="1"
        android:ellipsize="end"
        android:textStyle="bold"
        android:textSize="?attr/textSizeRoomName"
        android:textColor="?attr/colorTextOnFocus"
        tools:text="Barn Crew" />

    <TextView
        android:id="@+id/room_preview"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@id/room_name"
        android:layout_toStartOf="@id/room_unread"
        android:layout_toEndOf="@id/room_avatar"
        android:duplicateParentState="true"
        android:maxLines="1"
        android:ellipsize="end"
        android:textSize="?attr/textSizeRoomPreview"
        android:textColor="?attr/colorTextMetaOnFocus"
        tools:text="See you at six by the north gate" />
</RelativeLayout>
