<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="@dimen/content_pad">

    <!-- Entry group -->
    <LinearLayout
        android:id="@+id/entry_group"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/type_address_label"
            android:textSize="?attr/textSizeMeta"
            android:textColor="?attr/colorTextSecondary" />

        <EditText
            android:id="@+id/address_field"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/focus_selector"
            android:focusable="true"
            android:focusableInTouchMode="true"
            android:inputType="textEmailAddress"
            android:importantForAutofill="no"
            android:textSize="?attr/textSizeBody"
            android:textColor="?attr/colorTextPrimary" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/type_address_hint"
            android:textSize="?attr/textSizeMeta"
            android:textColor="?attr/colorTextSecondary" />

        <TextView
            android:id="@+id/type_error"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="?attr/textSizeMeta"
            android:textColor="?attr/colorError"
            android:visibility="gone"
            tools:text="That does not look like an address." />

        <TextView
            android:id="@+id/type_blocked"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="?attr/textSizeAddress"
            android:textColor="?attr/colorWarning"
            android:visibility="gone"
            tools:text="Your organization does not allow messages to example.org." />

        <TextView
            android:id="@+id/continue_button"
            style="@style/Widget.MatChat.Row"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/type_address_continue"
            android:textSize="?attr/textSizeLabel"
            android:textColor="?attr/colorTextOnFocus" />
    </LinearLayout>

    <!-- Confirmation group (S21 step 4) -->
    <LinearLayout
        android:id="@+id/confirm_group"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:visibility="gone">

        <TextView
            android:id="@+id/confirm_prompt"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="?attr/textSizeBody"
            android:textColor="?attr/colorTextPrimary"
            tools:text="Send to Wayne Zimmerman?" />

        <TextView
            android:id="@+id/confirm_address"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="?attr/textSizeAddress"
            android:textColor="?attr/colorTextSecondary"
            tools:text="@wayne:example.org" />

        <TextView
            android:id="@+id/confirm_encryption"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="?attr/textSizeMeta"
            android:textColor="?attr/colorEncrypted"
            android:text="@string/type_address_encrypted" />

        <TextView
            android:id="@+id/confirm_start"
            style="@style/Widget.MatChat.Row"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/type_address_start"
            android:textSize="?attr/textSizeLabel"
            android:textColor="?attr/colorTextOnFocus" />

        <TextView
            android:id="@+id/confirm_change"
            style="@style/Widget.MatChat.Row"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/type_address_change"
            android:textSize="?attr/textSizeLabel"
            android:textColor="?attr/colorTextOnFocus" />
    </LinearLayout>
</LinearLayout>
