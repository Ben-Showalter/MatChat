<?xml version="1.0" encoding="utf-8"?>
<!-- Settings > Text size (UX-SPEC §S16). Three focusable rows, Normal/Small/
     Large; CENTER (or a tap) selects one. The selected row carries a
     trailing checkmark (theme_row_selected_format, shared with S24 Theme
     and Advanced), never color alone (AGENTS.md). -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="@dimen/content_pad"
        android:paddingEnd="@dimen/content_pad">

        <TextView
            android:id="@+id/text_size_normal"
            style="@style/Widget.MatChat.Row"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="?attr/textSizeLabel"
            android:textColor="?attr/colorTextOnFocus" />

        <TextView
            android:id="@+id/text_size_small"
            style="@style/Widget.MatChat.Row"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="?attr/textSizeLabel"
            android:textColor="?attr/colorTextOnFocus" />

        <TextView
            android:id="@+id/text_size_large"
            style="@style/Widget.MatChat.Row"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="?attr/textSizeLabel"
            android:textColor="?attr/colorTextOnFocus" />
    </LinearLayout>
</ScrollView>
