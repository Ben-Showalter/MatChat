<?xml version="1.0" encoding="utf-8"?>
<!-- Voice call screen (incoming + in-call). Centred, high-contrast, no touch
     needed: CALL answers, END hangs up, CENTER mutes, Options routes speaker. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center"
    android:padding="@dimen/content_pad">

    <TextView
        android:id="@+id/call_peer"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textSize="?attr/textSizeHeading"
        android:textColor="?attr/colorTextPrimary"
        android:gravity="center" />

    <TextView
        android:id="@+id/call_status"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:textSize="?attr/textSizeBody"
        android:textColor="?attr/colorTextSecondary"
        android:gravity="center" />

    <TextView
        android:id="@+id/call_encryption"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:textSize="?attr/textSizeMeta"
        android:textColor="?attr/colorWarning"
        android:gravity="center"
        android:text="@string/call_not_e2ee" />

    <TextView
        android:id="@+id/call_hint"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:textSize="?attr/textSizeMeta"
        android:textColor="?attr/colorTextSecondary"
        android:gravity="center" />
</LinearLayout>
