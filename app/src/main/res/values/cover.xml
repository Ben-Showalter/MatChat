<?xml version="1.0" encoding="utf-8"?>
<!-- The Kyocera cover clock card (layout/cover_card.xml). The cover is a
     separate ~96 px display, not the main UI, so it has its own color and
     sizes rather than the :core:ui palette roles: white text on Kyocera's
     own black container for custom layouts. -->
<resources>
    <color name="cover_text">#FFFFFF</color>

    <dimen name="cover_clock_text">30sp</dimen>
    <dimen name="cover_banner_text">12sp</dimen>
    <dimen name="cover_banner_icon">12dp</dimen>
</resources>
