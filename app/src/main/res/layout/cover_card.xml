<?xml version="1.0" encoding="utf-8"?>
<!-- Cover (sub-LCD) clock card (CoverCardStyle.CLOCK / CLOCK_FULL,
     docs/COVER-DISPLAY.md), handed to SubLcdNotificationExtender
     .setRemoteViews. Kyocera's container for a custom layout draws black,
     so: no background of our own, white text, and plain TextViews that
     CoverScreenNotifier fills at each post (a TextClock version drew
     nothing). Not focusable or interactive — not a phone screen. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:gravity="center"
    android:orientation="vertical"
    android:paddingHorizontal="2dp">

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:baselineAligned="true"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/cover_time"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:includeFontPadding="false"
            android:textColor="@color/cover_text"
            android:textSize="@dimen/cover_clock_text"
            android:textStyle="bold" />

        <!-- AM/PM, small beside the time; empty in 24-hour mode. -->
        <TextView
            android:id="@+id/cover_ampm"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="2dp"
            android:includeFontPadding="false"
            android:textColor="@color/cover_text"
            android:textSize="@dimen/cover_banner_text" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:layout_width="@dimen/cover_banner_icon"
            android:layout_height="@dimen/cover_banner_icon"
            android:layout_marginEnd="2dp"
            android:contentDescription="@null"
            android:src="@drawable/ic_stat_message" />

        <!-- One ticker frame; CoverScreenNotifier scrolls it by reposting. -->
        <TextView
            android:id="@+id/cover_banner"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:maxLines="1"
            android:textColor="@color/cover_text"
            android:textSize="@dimen/cover_banner_text" />
    </LinearLayout>
</LinearLayout>
