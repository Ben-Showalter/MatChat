<?xml version="1.0" encoding="utf-8"?>
<!-- The Kyocera cover (sub-LCD) card, handed to SubLcdNotificationExtender
     .setRemoteViews (CoverScreenNotifier, docs/COVER-DISPLAY.md). The card
     covers the cover screen's own clock, so it carries one: the time large,
     like the idle cover, with the new-message banner along the bottom. Not a
     phone screen — nothing here is focusable or interactive, and the cover
     (~96 px square) is far below the 240 dp the main UI is designed for, so
     sizes are its own. Only RemoteViews-supported views (LinearLayout,
     TextClock, ImageView, TextView). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/cover_background"
    android:gravity="center"
    android:orientation="vertical"
    android:paddingHorizontal="2dp">

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:baselineAligned="true"
        android:orientation="horizontal">

        <!-- TextClock follows the system 12/24-hour setting and ticks by
             itself, so the time stays live without reposting the card. -->
        <TextClock
            android:id="@+id/cover_clock"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:format12Hour="h:mm"
            android:format24Hour="H:mm"
            android:includeFontPadding="false"
            android:textColor="@color/cover_text"
            android:textSize="@dimen/cover_clock_text"
            android:textStyle="bold" />

        <!-- AM/PM, small beside the time; empty in 24-hour mode. -->
        <TextClock
            android:id="@+id/cover_ampm"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="2dp"
            android:format12Hour="a"
            android:format24Hour=""
            android:includeFontPadding="false"
            android:textColor="@color/cover_text"
            android:textSize="@dimen/cover_banner_text" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:layout_width="@dimen/cover_banner_icon"
            android:layout_height="@dimen/cover_banner_icon"
            android:layout_marginEnd="2dp"
            android:contentDescription="@null"
            android:src="@drawable/ic_stat_message" />

        <!-- One ticker frame; CoverScreenNotifier scrolls it by reposting. -->
        <TextView
            android:id="@+id/cover_banner"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:maxLines="1"
            android:textColor="@color/cover_text"
            android:textSize="@dimen/cover_banner_text" />
    </LinearLayout>
</LinearLayout>
