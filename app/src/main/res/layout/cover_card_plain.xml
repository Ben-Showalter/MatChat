<?xml version="1.0" encoding="utf-8"?>
<!-- Cover (sub-LCD) clock card, second attempt (CoverCardStyle.CLOCK_PLAIN,
     probe step 5, docs/COVER-DISPLAY.md). cover_card.xml drew only its black
     background on the DuraXV, so this one has no background (the cover's
     own shows through), dark text like the cover's idle clock, and plain
     TextViews that CoverScreenNotifier fills at each post instead of
     TextClock. Not focusable or interactive — not a phone screen. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:gravity="center"
    android:orientation="vertical"
    android:paddingHorizontal="2dp">

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:baselineAligned="true"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/cover_time"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:includeFontPadding="false"
            android:textColor="@color/cover_text_dark"
            android:textSize="@dimen/cover_clock_text"
            android:textStyle="bold" />

        <!-- AM/PM, small beside the time; empty in 24-hour mode. -->
        <TextView
            android:id="@+id/cover_ampm"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="2dp"
            android:includeFontPadding="false"
            android:textColor="@color/cover_text_dark"
            android:textSize="@dimen/cover_banner_text" />
    </LinearLayout>

    <!-- One ticker frame; CoverScreenNotifier scrolls it by reposting. -->
    <TextView
        android:id="@+id/cover_banner"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:gravity="center_horizontal"
        android:maxLines="1"
        android:textColor="@color/cover_text_dark"
        android:textSize="@dimen/cover_banner_text" />
</LinearLayout>
