<?xml version="1.0" encoding="utf-8"?>
<!-- An own (sent) message bubble (S9): mirrors bubble_received.xml — rounded
     only on the leading side, square on the trailing/end side where its
     accent stripe sits flush. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <layer-list>
            <item>
                <shape android:shape="rectangle">
                    <solid android:color="?attr/colorBubbleOwn" />
                    <corners
                        android:topLeftRadius="@dimen/bubble_corner_radius"
                        android:bottomLeftRadius="@dimen/bubble_corner_radius"
                        android:topRightRadius="0dp"
                        android:bottomRightRadius="0dp" />
                    <stroke
                        android:width="@dimen/bubble_border_width_focused"
                        android:color="?attr/colorFocusAccent" />
                </shape>
            </item>
            <item android:width="@dimen/bubble_stripe_width" android:gravity="end">
                <shape android:shape="rectangle">
                    <solid android:color="?attr/colorFocusAccent" />
                </shape>
            </item>
        </layer-list>
    </item>
    <item>
        <layer-list>
            <item>
                <shape android:shape="rectangle">
                    <solid android:color="?attr/colorBubbleOwn" />
                    <corners
                        android:topLeftRadius="@dimen/bubble_corner_radius"
                        android:bottomLeftRadius="@dimen/bubble_corner_radius"
                        android:topRightRadius="0dp"
                        android:bottomRightRadius="0dp" />
                    <stroke
                        android:width="@dimen/bubble_border_width"
                        android:color="?attr/colorDivider" />
                </shape>
            </item>
            <item android:width="@dimen/bubble_stripe_width" android:gravity="end">
                <shape android:shape="rectangle">
                    <solid android:color="?attr/colorFocusAccent" />
                </shape>
            </item>
        </layer-list>
    </item>
</selector>
