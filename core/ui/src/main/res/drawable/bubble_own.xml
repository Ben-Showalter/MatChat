<?xml version="1.0" encoding="utf-8"?>
<!-- An own (sent) message bubble (S9): mirrors bubble_received.xml, with the
     stripe on the trailing edge. The fill is the accent itself under
     ?attr/colorBubbleOwnVeil — in Light a paper veil (the same pale ~20%
     wash as before), in Dark a slight black veil so it reads as a solid
     colored bubble (TurboText) while body text keeps >= 7:1 on every
     accent. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <layer-list>
            <item>
                <shape android:shape="rectangle">
                    <solid android:color="?attr/colorFocusAccent" />
                    <corners android:radius="@dimen/bubble_corner_radius" />
                </shape>
            </item>
            <item>
                <shape android:shape="rectangle">
                    <solid android:color="?attr/colorBubbleStripeVeil" />
                    <corners android:radius="@dimen/bubble_corner_radius" />
                </shape>
            </item>
            <item android:end="@dimen/bubble_stripe_width">
                <shape android:shape="rectangle">
                    <solid android:color="?attr/colorFocusAccent" />
                    <corners
                        android:topLeftRadius="@dimen/bubble_corner_radius"
                        android:bottomLeftRadius="@dimen/bubble_corner_radius"
                        android:topRightRadius="@dimen/bubble_corner_radius_inner"
                        android:bottomRightRadius="@dimen/bubble_corner_radius_inner" />
                </shape>
            </item>
            <item android:end="@dimen/bubble_stripe_width">
                <shape android:shape="rectangle">
                    <solid android:color="?attr/colorBubbleOwnVeil" />
                    <corners
                        android:topLeftRadius="@dimen/bubble_corner_radius"
                        android:bottomLeftRadius="@dimen/bubble_corner_radius"
                        android:topRightRadius="@dimen/bubble_corner_radius_inner"
                        android:bottomRightRadius="@dimen/bubble_corner_radius_inner" />
                </shape>
            </item>
            <item>
                <shape android:shape="rectangle">
                    <solid android:color="@android:color/transparent" />
                    <corners android:radius="@dimen/bubble_corner_radius" />
                    <stroke android:width="@dimen/bubble_border_width_focused" android:color="?attr/colorFocusAccent" />
                </shape>
            </item>
            <item>
                <shape android:shape="rectangle">
                    <solid android:color="@android:color/transparent" />
                    <corners android:radius="@dimen/bubble_corner_radius" />
                    <stroke android:width="@dimen/bubble_border_width_focused" android:color="?attr/colorBubbleStripeVeil" />
                </shape>
            </item>
        </layer-list>
    </item>
    <item>
        <layer-list>
            <item>
                <shape android:shape="rectangle">
                    <solid android:color="?attr/colorFocusAccent" />
                    <corners android:radius="@dimen/bubble_corner_radius" />
                </shape>
            </item>
            <item>
                <shape android:shape="rectangle">
                    <solid android:color="?attr/colorBubbleStripeVeil" />
                    <corners android:radius="@dimen/bubble_corner_radius" />
                </shape>
            </item>
            <item android:end="@dimen/bubble_stripe_width">
                <shape android:shape="rectangle">
                    <solid android:color="?attr/colorFocusAccent" />
                    <corners
                        android:topLeftRadius="@dimen/bubble_corner_radius"
                        android:bottomLeftRadius="@dimen/bubble_corner_radius"
                        android:topRightRadius="@dimen/bubble_corner_radius_inner"
                        android:bottomRightRadius="@dimen/bubble_corner_radius_inner" />
                </shape>
            </item>
            <item android:end="@dimen/bubble_stripe_width">
                <shape android:shape="rectangle">
                    <solid android:color="?attr/colorBubbleOwnVeil" />
                    <corners
                        android:topLeftRadius="@dimen/bubble_corner_radius"
                        android:bottomLeftRadius="@dimen/bubble_corner_radius"
                        android:topRightRadius="@dimen/bubble_corner_radius_inner"
                        android:bottomRightRadius="@dimen/bubble_corner_radius_inner" />
                </shape>
            </item>
            <item>
                <shape android:shape="rectangle">
                    <solid android:color="@android:color/transparent" />
                    <corners android:radius="@dimen/bubble_corner_radius" />
                    <stroke android:width="@dimen/bubble_border_width" android:color="?attr/colorBubbleBorder" />
                </shape>
            </item>
        </layer-list>
    </item>
</selector>
