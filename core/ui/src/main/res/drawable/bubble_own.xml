<?xml version="1.0" encoding="utf-8"?>
<!-- An own (sent) message bubble (S9): mirrors bubble_received.xml's
     border-based focus cue, plus a permanent trailing-edge accent stripe
     that received bubbles don't get — the reference screenshot's small
     "sent" bubble keeps a colored edge regardless of focus, so it's a
     property of being your own message, not of being focused. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <layer-list>
            <item>
                <shape android:shape="rectangle">
                    <solid android:color="?attr/colorBubbleOwn" />
                    <corners android:radius="@dimen/bubble_corner_radius" />
                    <stroke
                        android:width="@dimen/bubble_border_width_focused"
                        android:color="?attr/colorFocusAccent" />
                </shape>
            </item>
            <item android:width="@dimen/bubble_stripe_width" android:gravity="end">
                <shape android:shape="rectangle">
                    <solid android:color="?attr/colorFocusAccent" />
                    <corners
                        android:topRightRadius="@dimen/bubble_corner_radius"
                        android:bottomRightRadius="@dimen/bubble_corner_radius"
                        android:topLeftRadius="0dp"
                        android:bottomLeftRadius="0dp" />
                </shape>
            </item>
        </layer-list>
    </item>
    <item>
        <layer-list>
            <item>
                <shape android:shape="rectangle">
                    <solid android:color="?attr/colorBubbleOwn" />
                    <corners android:radius="@dimen/bubble_corner_radius" />
                    <stroke
                        android:width="@dimen/bubble_border_width"
                        android:color="?attr/colorDivider" />
                </shape>
            </item>
            <item android:width="@dimen/bubble_stripe_width" android:gravity="end">
                <shape android:shape="rectangle">
                    <solid android:color="?attr/colorFocusAccent" />
                    <corners
                        android:topRightRadius="@dimen/bubble_corner_radius"
                        android:bottomRightRadius="@dimen/bubble_corner_radius"
                        android:topLeftRadius="0dp"
                        android:bottomLeftRadius="0dp" />
                </shape>
            </item>
        </layer-list>
    </item>
</selector>
