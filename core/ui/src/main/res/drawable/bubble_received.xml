<?xml version="1.0" encoding="utf-8"?>
<!-- A received message bubble (S9): a fill rounded only on the trailing
     side (square on the leading/start side, where the accent stripe sits
     flush — a "flag" shape, not a full rounded rect) plus a colored accent
     stripe on the leading edge (?attr/colorFocusAccent — the user's chosen
     accent, Settings > Theme, not a hardcoded color). The border recolors
     and thickens on focus instead of the row's usual flat fill + trailing
     bar (focus_indicator.xml) — a deliberate, scoped exception to the
     one-focus-style rule (AGENTS.md §4 note), since item_message.xml
     leaves the row's own background transparent and lets this drawable
     carry focus instead. Reacts to the row's focus via
     android:duplicateParentState on message_bubble/image_bubble (their
     direct parent), not by being focusable itself. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <layer-list>
            <item>
                <shape android:shape="rectangle">
                    <solid android:color="?attr/colorBubbleReceived" />
                    <corners
                        android:topLeftRadius="0dp"
                        android:bottomLeftRadius="0dp"
                        android:topRightRadius="@dimen/bubble_corner_radius"
                        android:bottomRightRadius="@dimen/bubble_corner_radius" />
                    <stroke
                        android:width="@dimen/bubble_border_width_focused"
                        android:color="?attr/colorFocusAccent" />
                </shape>
            </item>
            <item android:width="@dimen/bubble_stripe_width" android:gravity="start">
                <shape android:shape="rectangle">
                    <solid android:color="?attr/colorFocusAccent" />
                </shape>
            </item>
        </layer-list>
    </item>
    <item>
        <layer-list>
            <item>
                <shape android:shape="rectangle">
                    <solid android:color="?attr/colorBubbleReceived" />
                    <corners
                        android:topLeftRadius="0dp"
                        android:bottomLeftRadius="0dp"
                        android:topRightRadius="@dimen/bubble_corner_radius"
                        android:bottomRightRadius="@dimen/bubble_corner_radius" />
                    <stroke
                        android:width="@dimen/bubble_border_width"
                        android:color="?attr/colorDivider" />
                </shape>
            </item>
            <item android:width="@dimen/bubble_stripe_width" android:gravity="start">
                <shape android:shape="rectangle">
                    <solid android:color="?attr/colorFocusAccent" />
                </shape>
            </item>
        </layer-list>
    </item>
</selector>
