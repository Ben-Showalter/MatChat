<?xml version="1.0" encoding="utf-8"?>
<!-- A thin full-width hairline for separating rows in a list (TurboText
     reference: conversation rows read as distinct even when none is
     focused, not only via the focus highlight). Shared so any list restyle
     can reuse it, the way focus_selector is shared. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="?attr/colorDivider" />
    <size android:height="1dp" />
</shape>
