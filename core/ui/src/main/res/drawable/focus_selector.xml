<?xml version="1.0" encoding="utf-8"?>
<!-- The one focus highlight for the whole app (AGENTS.md §4, UX-SPEC §2):
     a subtle full-row fill plus a colored accent bar on the trailing edge
     (focus_indicator.xml), no rounded corners, no ripple. Replaces the
     earlier boxed light-green block + 2 dp border, per explicit user
     direction against a TurboText reference screenshot. Never write a
     per-screen focus highlight. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true" android:drawable="@drawable/focus_indicator" />
    <item android:state_selected="true" android:drawable="@drawable/focus_indicator" />
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@android:color/transparent" />
        </shape>
    </item>
</selector>
