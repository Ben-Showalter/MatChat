<?xml version="1.0" encoding="utf-8"?>
<!-- Base theme for MatChat. AppCompat, not Material: Views deliberately
     (docs/adr/0002). No ripples, no elevation, no animation over 150 ms. -->
<resources>
    <style name="Theme.MatChat" parent="Theme.AppCompat.Light.NoActionBar">
        <!-- Theme-attr indirection layer (attrs.xml): every semantic role maps
             here to its current @color/<role> value, so a future theme is a
             values-themes.xml addition, not a layout rewrite. -->
        <item name="colorSurface">@color/surface</item>
        <item name="colorSurfaceBright">@color/surface_bright</item>
        <item name="colorSurfaceInverse">@color/surface_inverse</item>
        <item name="colorSurfaceFocused">@color/surface_focused</item>
        <item name="colorTextPrimary">@color/text_primary</item>
        <item name="colorTextSecondary">@color/text_secondary</item>
        <item name="colorTextOnInverse">@color/text_on_inverse</item>
        <item name="colorTextOnFocus">@color/text_on_focus</item>
        <item name="colorTextMetaOnFocus">@color/text_meta_on_focus</item>
        <item name="colorTextLink">@color/text_link</item>
        <item name="colorDivider">@color/divider</item>
        <item name="colorFocusAccent">@color/focus_accent</item>
        <item name="colorEncrypted">@color/encrypted</item>
        <item name="colorWarning">@color/warning</item>
        <item name="colorError">@color/error</item>
        <item name="colorScrim">@color/scrim</item>

        <item name="android:windowBackground">?attr/colorSurface</item>
        <item name="android:textColorPrimary">?attr/colorTextPrimary</item>
        <item name="android:textColorSecondary">?attr/colorTextSecondary</item>
        <item name="colorAccent">?attr/colorEncrypted</item>
        <item name="android:windowAnimationStyle">@null</item>
        <!-- These are D-pad devices: never behave as if a touch is available. -->
        <item name="android:windowIsTranslucent">false</item>
    </style>

    <!-- A focusable row: full-width inverse focus block, no touch feedback.
         parent="" so the dotted name is not read as inheriting from a
         non-existent "Widget.MatChat" (AAPT implicit-parent rule). -->
    <style name="Widget.MatChat.Row" parent="">
        <item name="android:background">@drawable/focus_selector</item>
        <item name="android:focusable">true</item>
        <item name="android:focusableInTouchMode">false</item>
        <item name="android:minHeight">@dimen/row_min_height</item>
        <item name="android:paddingStart">@dimen/content_pad</item>
        <item name="android:paddingEnd">@dimen/content_pad</item>
        <item name="android:gravity">center_vertical</item>
    </style>

    <!-- Text.* use parent="" for the same implicit-parent reason as above. -->
    <style name="Text.Body" parent="">
        <item name="android:textSize">@dimen/text_body</item>
        <item name="android:textColor">?attr/colorTextOnFocus</item>
    </style>

    <style name="Text.Label" parent="">
        <item name="android:textSize">@dimen/text_label</item>
        <item name="android:textColor">?attr/colorTextOnFocus</item>
    </style>

    <style name="Text.Meta" parent="">
        <item name="android:textSize">@dimen/text_meta</item>
        <item name="android:textColor">?attr/colorTextMetaOnFocus</item>
    </style>

    <!-- The MenuSheet dialog: bottom-anchored, non-floating, BACK dismisses. Uses
         a plain (non-AppCompat) dialog theme so a non-floating window is allowed. -->
    <style name="Theme.MatChat.Menu" parent="@android:style/Theme.DeviceDefault.Light.Dialog">
        <item name="android:windowIsFloating">false</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowContentOverlay">@null</item>
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowAnimationStyle">@null</item>
        <item name="android:backgroundDimEnabled">true</item>
    </style>
</resources>
