<?xml version="1.0" encoding="utf-8"?>
<!-- Type floor (PLAN.md G5, UX-SPEC §2): body 16 sp · interactive labels 14 sp ·
     secondary metadata 11 sp. Nothing a user reads goes below 11 sp. -->
<resources>
    <!-- Text sizes -->
    <dimen name="text_body">16sp</dimen>
    <dimen name="text_label">14sp</dimen>
    <dimen name="text_meta">11sp</dimen>
    <dimen name="text_room_name">16sp</dimen>
    <dimen name="text_sender">12sp</dimen>
    <dimen name="text_heading">17sp</dimen>
    <!-- Softkey bar labels only (view_softkey_bar.xml) — a dedicated size,
         bumped from the shared 11sp text_meta floor for legibility
         (UI improvement plan, Phase 4). Do not reuse text_meta's dimen for
         this or bump text_meta itself: timestamps/day-separators/sender
         names also use it and UX-SPEC.md specifies them separately. -->
    <dimen name="text_softkey_label">13sp</dimen>

    <!-- Chrome bands (UX-SPEC §1) -->
    <dimen name="title_bar_height">18dp</dimen>
    <dimen name="softkey_bar_height">20dp</dimen>

    <!-- Rows use minHeight, never a fixed height (UX-SPEC S16). -->
    <dimen name="row_min_height">44dp</dimen>
    <dimen name="row_min_height_compact">36dp</dimen>

    <!-- Focus highlight: trailing-edge accent bar width, no rounded corners
         (UX-SPEC §2). Widened from 3dp after the first pass read as barely
         visible against the subtle fill. -->
    <dimen name="focus_bar_width">6dp</dimen>

    <dimen name="content_pad">8dp</dimen>

    <!-- S9 message bubbles (item_message.xml, item_message_image.xml). Max
         width reaches nearly the full row width (reference-device
         screenshot — only a hairline gap on the unoccupied side), on the
         240dp-wide reference portrait viewport (PLAN.md §8.2) — this app
         targets one fixed screen class, not a range, so a dp cap (not a
         percentage) matches every other dimension here. Corners are
         rounded only on the side away from the accent stripe (a "flag"
         shape — square where the stripe sits, so it's flush, not
         interrupted by a curve); bubble_received.xml/bubble_own.xml split
         bubble_corner_radius per-corner rather than using it on all four. -->
    <dimen name="bubble_corner_radius">8dp</dimen>
    <!-- Accent stripe on the leading/trailing edge (own messages: trailing;
         received: leading — both get one). -->
    <dimen name="bubble_stripe_width">3dp</dimen>
    <dimen name="bubble_max_width">220dp</dimen>
    <dimen name="bubble_pad_h">8dp</dimen>
    <dimen name="bubble_pad_v">4dp</dimen>
    <!-- Border-based focus cue (replaces the row-wide flat fill for message
         bubbles specifically — AGENTS.md §4 exception, see its note). -->
    <dimen name="bubble_border_width">1dp</dimen>
    <dimen name="bubble_border_width_focused">2dp</dimen>
</resources>
